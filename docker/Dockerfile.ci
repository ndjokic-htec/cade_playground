FROM ubuntu:22.04

RUN apt update && apt install -y \
    build-essential \
    curl \
    wget \
    git \
    python3 \
    python3-pip \
    apt-transport-https \
    gnupg

RUN curl -fsSL https://bazel.build/bazel-release.pub.gpg \
    | gpg --dearmor -o /usr/share/keyrings/bazel.gpg

RUN echo "deb [signed-by=/usr/share/keyrings/bazel.gpg] \
    https://storage.googleapis.com/bazel-apt stable jdk1.8" \
    > /etc/apt/sources.list.d/bazel.list

RUN apt update && apt install -y bazel

WORKDIR /workspace